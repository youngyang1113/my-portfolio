# Render / 本地运行留言 API 时配置（GITHUB_TOKEN 勿提交到 Git）

# GitHub Personal Access Token（classic）：勾选 repo 权限，用于读写 data/messages.json
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# 目标仓库与分支
GITHUB_REPO=youngyang1113/my-portfolio
GITHUB_BRANCH=master

# 仓库内留言文件路径（默认 data/messages.json）
GITHUB_MESSAGES_PATH=data/messages.json

PORT=3456
